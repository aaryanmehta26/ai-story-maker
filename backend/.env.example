PORT=4000
CLIENT_ORIGIN=*
API_BASE_URL=http://localhost:4000

OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Firebase is optional for local development. If omitted, backend/data/stories.json
# and backend/uploads are used so the app can run immediately.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

